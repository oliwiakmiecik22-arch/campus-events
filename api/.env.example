# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Local development and tests use SQLite. Production can set DATABASE_URL instead.
DB_STORAGE=./data/events.sqlite
# DATABASE_URL=
# Brevo HTTPS confirmation emails. Put real credentials only in your local .env file.
# BREVO_API_KEY=
# EMAIL_FROM="Campus Events <noreply@example.com>"
EMAIL_TIMEOUT_MS=3000
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
