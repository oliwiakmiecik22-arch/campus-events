# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# Set this to a random secret of at least 32 bytes before enabling remote MCP.
# Keep the production value in the hosting provider's secret manager, never in Git.
MCP_AUTH_TOKEN=
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
